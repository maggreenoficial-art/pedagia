SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Chave de API (não use chave "management"). Crie em https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui
# Geração de imagens na aba Minhas mídias (https://docs.kie.ai/market/gpt/gpt-image-2-text-to-image)
KIE_API_KEY=sua-chave-kie-aqui
KIE_IMAGE_MODEL=gpt-image-2-text-to-image
# Next.js (npm run dev / npm run start)
# Após configurar o projeto, execute supabase/schema.sql no SQL Editor
# (tabela pedagia_workspace, bucket Storage "pedagia", políticas RLS).
# PDFs > ~50 MB: Supabase Dashboard → Storage → Settings → aumente o limite global
# (ex. 200 MB) e confira o bucket "pedagia" (schema.sql define file_size_limit 200 MB).
